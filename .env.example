PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=uXXXX_user
DB_PASSWORD=isi_password
DB_NAME=uXXXX_umkm
JWT_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter

# URL publik aplikasi (dipakai untuk tautan di email)
APP_URL=https://saas.pusakabakery.com
# SMTP Hostinger (hPanel -> Emails -> Email Accounts -> Connect apps & devices)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@pusakabakery.com
SMTP_PASS=isi_password_email
MAIL_FROM="UMKM SaaS <noreply@pusakabakery.com>"
# 1 = akun wajib verifikasi email sebelum memakai fitur bisnis
REQUIRE_VERIFIED=0

# WhatsApp (Baileys). Simpan sesi DI LUAR folder aplikasi agar tidak hilang saat upload ulang, mis. /home/uXXXX/wa_sessions
WA_SESSION_DIR=
WA_DELAY_MIN=8
WA_DELAY_MAX=20
WA_MAX_SESSIONS=5
WA_MAX_DAILY=200
